{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "arash",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "f4705878-812b-4ac6-bbff-f4ec88bdf3c4","database_name": "arash" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "08a742aea0844d9ca14481ecbd262ddb" }
  ],
  "vars": {
    "PAGES_URL": "https://arash/pl"
  },
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
